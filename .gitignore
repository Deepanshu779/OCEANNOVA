# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
*.env
.venv/
env/
venv/
ENV/

# Node / Frontend
node_modules/
dist/
build/
.next/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Logs and databases
*.log
*.sqlite3
*.db

# OS generated
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Generated/processed outputs (keep raw source data separately)
data/processed/

# Local runtime data
data/real/ais/*.csv

# Do NOT ignore the official raw Sentinel-1 dataset.
# Use Git LFS for .tif files because GitHub's normal file limit is too small.
!data/external/
!data/external/Radar_data/
!data/external/Radar_data/**/*.tif
!data/external/Radar_data/**/*.TIF
